# JCXPRESS - Environment Configuration

# Admin Configuration
ADMIN_PASSWORD=your-strong-admin-password-here
JWT_SECRET=your-super-secret-jwt-key-change-this

# Twilio SMS Configuration (Optional - for SMS notifications)
# Sign up at https://twilio.com (free trial available)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Email Configuration (Free with Gmail)
# Use Gmail App Password (not regular password)
# Enable 2FA first, then generate app password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password

# Stripe Payment Configuration
# Sign up at https://stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# SQLite database will be created automatically as database.db
# No configuration needed for SQLite
